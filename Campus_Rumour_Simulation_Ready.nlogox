<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; CAMPUS RUMOUR SPREADING SIMULATION
;; Agent-Based Modelling project | NetLogo 7
;; Student states: unaware (sky), believer (orange), verified (green)

turtles-own [rumor-status]

;; Number of students in each state; used by monitors and graph.
to-report unaware-count
  report count turtles with [rumor-status = "unaware"]
end

to-report believer-count
  report count turtles with [rumor-status = "believer"]
end

to-report verified-count
  report count turtles with [rumor-status = "verified"]
end

;; Reset and initialize the campus population.
to setup
  clear-all

  create-turtles population [
    setxy random-xcor random-ycor
    set heading random 360
    set shape "person"
    set size 1.2
    set rumor-status "unaware"
    set color sky
  ]

  ;; Ensure the seed count cannot exceed the total population.
  let number-to-seed min (list initial-believers count turtles)
  ask n-of number-to-seed turtles [
    set rumor-status "believer"
    set color orange
  ]

  ;; Starts ticks and initializes plot values at tick 0.
  reset-ticks
end

;; Run one simulation step.
to go
  ;; End the run when no one can spread the rumour,
  ;; or when the configured experiment time limit is reached.
  if believer-count = 0 [ stop ]
  if ticks >= max-ticks [ stop ]

  ;; Each student moves a short distance around the campus.
  ask turtles [
    rt random 50
    lt random 50
    fd 0.5
  ]

  ;; Only students who were believers at the start of this phase
  ;; can initiate transmission during this phase.
  ask turtles with [rumor-status = "believer"] [
    ask other turtles in-radius 1.5 [
      if rumor-status = "unaware" [
        if random-float 100 < spread-probability [
          set rumor-status "believer"
          set color orange
        ]
      ]
    ]
  ]

  ;; A believer can fact-check and become a non-spreader.
  ;; The fact-checking stage comes AFTER the spreading stage.
  ask turtles with [rumor-status = "believer"] [
    if random-float 100 < fact-check-probability [
      set rumor-status "verified"
      set color green
    ]
  ]

  ;; Update plot and monitors automatically.
  tick

  ;; Halt the forever button immediately on terminal conditions.
  if believer-count = 0 [ stop ]
  if ticks >= max-ticks [ stop ]
end
]]></code>
